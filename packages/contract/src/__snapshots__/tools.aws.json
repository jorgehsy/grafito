[
  {
    "name": "create_zone",
    "description": "Creates a zone (a topic box) on the board. Use it when the speaker starts a new topic. kind: flow = step-by-step process; system = architecture of components; list = list of items; compare = two columns compared; mindmap = branching ideas; scale = a quantity that changes along an axis (bar with thresholds: percentage, capacity, time, level); cycle = something that repeats in a loop; timeline = events or phases over time, before/now; tree = a hierarchy or classification that grows from left to right (categories with subcategories, types with their outcomes, breakdowns). No coordinates are given: the board places the zone. 'place' only to ask for a neighbor.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique, stable identifier, e.g. 'order_process'."
        },
        "kind": {
          "type": "string",
          "enum": [
            "flow",
            "system",
            "list",
            "compare",
            "mindmap",
            "scale",
            "cycle",
            "timeline",
            "tree"
          ]
        },
        "title": {
          "type": "string",
          "description": "Short title of the zone."
        },
        "left_title": {
          "type": "string",
          "description": "Compare only: title of the left column."
        },
        "right_title": {
          "type": "string",
          "description": "Compare only: title of the right column."
        },
        "min_label": {
          "type": "string",
          "description": "Scale only: label of the left end of the bar (default '0%')."
        },
        "max_label": {
          "type": "string",
          "description": "Scale only: label of the right end of the bar (default '100%')."
        },
        "center_label": {
          "type": "string",
          "description": "Cycle only: text in the center of the cycle, what cycles (e.g. 'Context window')."
        },
        "place": {
          "type": "object",
          "description": "Optional placement hint relative to another zone.",
          "properties": {
            "relation": {
              "type": "string",
              "enum": [
                "right_of",
                "below"
              ]
            },
            "of": {
              "type": "string",
              "minLength": 1,
              "description": "Id of the reference zone."
            }
          },
          "required": [
            "relation",
            "of"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "title"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_step",
    "description": "Adds a step (rectangle) to a flow zone. 'after' connects it to the previous step automatically.",
    "input_schema": {
      "type": "object",
      "properties": {
