  {
    "name": "add_node",
    "description": "Adds an idea to a mindmap zone. Without 'parent' it is the central idea (or hangs from it).",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a mindmap zone."
