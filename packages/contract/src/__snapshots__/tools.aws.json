        },
        "service": {
          "type": "string",
          "enum": [
            "lambda",
            "ec2",
            "ecs",
            "eks",
            "fargate",
            "s3",
            "efs",
            "dynamodb",
            "rds",
            "aurora",
            "elasticache",
            "api-gateway",
            "cloudfront",
            "route-53",
            "vpc",
            "elb",
            "sqs",
            "sns",
            "eventbridge",
            "step-functions",
            "appsync",
            "cognito",
            "iam",
            "kms",
            "secrets-manager",
            "waf",
            "cloudwatch",
            "cloudformation",
            "cloudtrail",
            "kinesis",
            "athena",
            "glue",
            "redshift",
            "opensearch",
            "bedrock",
            "sagemaker",
            "codepipeline",
