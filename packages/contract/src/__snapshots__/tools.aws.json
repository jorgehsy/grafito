  {
    "name": "update_text",
    "description": "Cambia o BORRA un texto dentro de un elemento sin borrar el elemento. field: label = título de zona, etiqueta de elemento o de conexión; note = nota de una marca, etapa, evento o nodo de árbol; text = texto de una nota manuscrita (callout); when = fecha de un evento. Un value vacío quita el texto opcional (note, when, label de conexión). Úsala en lugar de delete cuando sólo se pide quitar o cambiar un texto.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Id del elemento, zona, conexión o nota."
        },
        "field": {
          "type": "string",
          "enum": [
            "label",
            "note",
            "text",
            "when"
          ]
        },
        "value": {
          "type": "string",
          "description": "Texto nuevo; vacío para quitarlo."
        }
      },
      "required": [
        "id",
        "field",
        "value"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "delete",
    "description": "Borra un elemento, conexión, nota o zona. Borrar una zona borra todo su contenido; borrar un elemento quita sus conexiones.",
    "input_schema": {
      "type": "object",
      "properties": {
