  {
    "name": "add_node",
    "description": "Añade una idea a una zona mindmap. Sin 'parent' es la idea central (o cuelga de ella).",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id de una zona mindmap."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único."
        },
        "label": {
          "type": "string",
          "description": "Idea breve."
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "description": "Id del nodo padre."
        }
      },
      "required": [
        "zone",
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_item",
    "description": "Añade un punto a una zona list o compare. En compare, 'column' elige la columna.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id de una zona list o compare."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único."
        },
        "text": {
          "type": "string",
          "description": "Texto del punto."
        },
        "column": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        }
      },
      "required": [
        "zone",
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_branch",
    "description": "Añade un nodo a una zona tree: una caja en la jerarquía. Sin 'parent' es una raíz (varias raíces se apilan); con 'parent' cuelga de ese nodo, en una columna a su derecha. Los hermanos se apilan en el orden en que se añaden y el tablero dibuja los conectores. Los padres antes que los hijos.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id de una zona tree."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único."
        },
        "label": {
          "type": "string",
          "description": "Nombre breve del nodo (1 a 4 palabras)."
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "description": "Id del nodo padre (opcional; sin él es raíz)."
        },
        "note": {
          "type": "string",
          "description": "Explicación corta debajo de la etiqueta (opcional)."
        }
      },
      "required": [
        "zone",
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_mark",
    "description": "Añade una marca (umbral) a una zona scale: una muesca en la barra con su etiqueta y, debajo, una explicación corta. 'at' es la posición en la barra, de 0 a 100. El tablero evita que las etiquetas se pisen.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id de una zona scale."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único."
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Posición en la barra, de 0 a 100."
        },
        "label": {
          "type": "string",
          "description": "Etiqueta breve de la marca, p. ej. '20%: empeoran'."
        },
        "note": {
          "type": "string",
          "description": "Explicación corta que se escribe debajo (opcional)."
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "warn",
            "danger",
            "ok"
          ],
          "description": "neutral = tinta; warn = ámbar (cuidado); danger = rojo (límite peligroso); ok = verde."
        }
      },
      "required": [
        "zone",
        "id",
        "at",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_stage",
    "description": "Añade una etapa a una zona cycle. Las etapas se colocan en círculo en el orden en que se añaden (o tras 'after'), con flechas en sentido horario y la última vuelve a la primera.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id de una zona cycle."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único."
        },
        "label": {
          "type": "string",
          "description": "Nombre breve de la etapa (2 a 5 palabras)."
        },
        "note": {
          "type": "string",
          "description": "Explicación corta debajo (opcional)."
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "description": "Id de la etapa tras la que se inserta (opcional; por defecto al final)."
        }
      },
      "required": [
        "zone",
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_event",
    "description": "Añade un evento o fase a una zona timeline: una marca sobre el eje del tiempo con 'when' junto a la marca y su etiqueta en una caja arriba o abajo. Sin 'at' los eventos se reparten por igual en el orden en que se añaden; con 'at' (0 a 100) se colocan proporcionalmente.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id de una zona timeline."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único."
        },
        "label": {
          "type": "string",
          "description": "Texto breve del evento."
        },
        "when": {
          "type": "string",
          "description": "Fecha o etiqueta breve junto a la marca: 'Antes', '2024', 'Mes 1' (opcional)."
        },
        "note": {
          "type": "string",
          "description": "Explicación corta debajo de la etiqueta (opcional)."
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Posición en el eje, de 0 a 100 (opcional)."
        }
      },
      "required": [
        "zone",
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_span",
    "description": "Añade a una zona timeline un tramo (llave bajo el eje) que cubre una duración, p. ej. '2 a 3 meses'. 'from' y 'to' son posiciones del eje de 0 a 100, con from < to.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id de una zona timeline."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único."
        },
        "from": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Inicio del tramo, de 0 a 100."
        },
        "to": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Final del tramo, de 0 a 100 (mayor que from)."
        },
        "label": {
          "type": "string",
          "description": "Texto breve del tramo, p. ej. '2 a 3 meses'."
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "warn",
            "danger",
            "ok"
          ],
          "description": "neutral = tinta; warn = ámbar (lento o costoso); danger = rojo; ok = verde (bueno)."
        }
      },
      "required": [
        "zone",
        "id",
        "from",
        "to",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "set_level",
    "description": "Rellena la barra de una zona scale hasta 'at' (0 a 100): el nivel actual, p. ej. 'se va llenando'. Volver a llamarla mueve el nivel.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id de una zona scale."
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Hasta dónde llega el relleno, de 0 a 100."
        },
        "label": {
          "type": "string",
          "description": "Texto breve sobre el relleno (opcional), p. ej. 'se va llenando'."
        }
      },
      "required": [
        "zone",
        "at"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "connect",
    "description": "Dibuja una flecha entre dos elementos, dentro de una zona o entre zonas distintas (p. ej. de un paso de un flujo a un componente de una arquitectura).",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único de la conexión."
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "Id del elemento origen."
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "Id del elemento destino."
        },
        "label": {
          "type": "string",
          "description": "Texto breve sobre la flecha."
        },
        "style": {
          "type": "string",
          "enum": [
            "solid",
            "dashed"
          ],
          "description": "dashed = relación opcional, asíncrona o débil."
        },
        "both_ways": {
          "type": "boolean",
          "description": "Flecha con punta en ambos extremos."
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
