          "type": "string",
          "description": "Short idea."
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "description": "Id of the parent node."
        }
      },
      "required": [
        "zone",
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_item",
    "description": "Adds an item to a list or compare zone. In compare, 'column' picks the column.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a list or compare zone."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier."
        },
        "text": {
          "type": "string",
          "description": "Text of the item."
        },
        "column": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        }
      },
      "required": [
        "zone",
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_branch",
    "description": "Adds a node to a tree zone: a box in the hierarchy. Without 'parent' it is a root (several roots stack up); with 'parent' it hangs from that node, in a column to its right. Siblings stack in the order they are added and the board draws the connectors. Parents before children.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a tree zone."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier."
        },
        "label": {
          "type": "string",
          "description": "Short name of the node (1 to 4 words)."
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "description": "Id of the parent node (optional; without it, a root)."
        },
        "note": {
          "type": "string",
          "description": "Short explanation under the label (optional)."
        }
      },
      "required": [
        "zone",
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_mark",
    "description": "Adds a mark (threshold) to a scale zone: a notch on the bar with its label and, underneath, a short explanation. 'at' is the position on the bar, from 0 to 100. The board keeps labels from overlapping.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a scale zone."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier."
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Position on the bar, from 0 to 100."
        },
        "label": {
          "type": "string",
          "description": "Short label of the mark, e.g. '20%: gets worse'."
        },
        "note": {
          "type": "string",
          "description": "Short explanation written underneath (optional)."
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "warn",
            "danger",
            "ok"
          ],
          "description": "neutral = ink; warn = amber (careful); danger = red (dangerous limit); ok = green."
        }
      },
      "required": [
        "zone",
        "id",
        "at",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_stage",
    "description": "Adds a stage to a cycle zone. Stages are placed in a circle in the order they are added (or after 'after'), with clockwise arrows, and the last one returns to the first.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a cycle zone."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier."
        },
        "label": {
          "type": "string",
          "description": "Short name of the stage (2 to 5 words)."
        },
        "note": {
          "type": "string",
          "description": "Short explanation underneath (optional)."
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "description": "Id of the stage to insert after (optional; default at the end)."
        }
      },
      "required": [
        "zone",
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_event",
    "description": "Adds an event or phase to a timeline zone: a tick on the time axis with 'when' next to the tick and its label in a box above or below. Without 'at' events are spread evenly in the order they are added; with 'at' (0 to 100) they are placed proportionally.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a timeline zone."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier."
        },
        "label": {
          "type": "string",
          "description": "Short text of the event."
        },
        "when": {
          "type": "string",
          "description": "Date or short tag next to the tick: 'Before', '2024', 'Month 1' (optional)."
        },
        "note": {
          "type": "string",
          "description": "Short explanation under the label (optional)."
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Position on the axis, from 0 to 100 (optional)."
        }
      },
      "required": [
        "zone",
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_span",
    "description": "Adds to a timeline zone a span (brace under the axis) covering a duration, e.g. '2 to 3 months'. 'from' and 'to' are axis positions from 0 to 100, with from < to.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a timeline zone."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier."
        },
        "from": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Start of the span, from 0 to 100."
        },
        "to": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "End of the span, from 0 to 100 (greater than from)."
        },
        "label": {
          "type": "string",
          "description": "Short text of the span, e.g. '2 to 3 months'."
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "warn",
            "danger",
            "ok"
          ],
          "description": "neutral = ink; warn = amber (slow or costly); danger = red; ok = green (good)."
        }
      },
      "required": [
        "zone",
        "id",
        "from",
        "to",
        "label"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "set_level",
    "description": "Fills the bar of a scale zone up to 'at' (0 to 100): the current level, e.g. 'filling up'. Calling it again moves the level.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a scale zone."
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "How far the fill reaches, from 0 to 100."
        },
        "label": {
          "type": "string",
          "description": "Short text over the fill (optional), e.g. 'filling up'."
        }
      },
      "required": [
        "zone",
        "at"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "connect",
    "description": "Draws an arrow between two elements, inside one zone or across zones (e.g. from a step of a flow to a component of an architecture).",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier of the connection."
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "Id of the source element."
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "Id of the target element."
        },
        "label": {
          "type": "string",
          "description": "Short text over the arrow."
        },
        "style": {
          "type": "string",
          "enum": [
            "solid",
            "dashed"
