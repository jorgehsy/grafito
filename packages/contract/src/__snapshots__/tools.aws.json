[
  {
    "name": "create_zone",
    "description": "Crea una zona (un recuadro temático) en el tablero. Úsala cuando el hablante empieza un tema nuevo. kind: flow = proceso paso a paso; system = arquitectura de componentes; list = lista de puntos; compare = dos columnas comparadas; mindmap = ideas ramificadas; scale = una cantidad que cambia sobre un eje (barra con umbrales: porcentaje, capacidad, tiempo, nivel); cycle = algo que se repite en bucle; timeline = eventos o fases en el tiempo, antes/ahora; tree = una jerarquía o clasificación que crece de izquierda a derecha (categorías con subcategorías, tipos con sus resultados, desgloses). No se dan coordenadas: el tablero coloca la zona. 'place' sólo para pedir vecindad.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único y estable, p. ej. 'proceso_pedido'."
        },
        "kind": {
          "type": "string",
          "enum": [
            "flow",
            "system",
            "list",
            "compare",
            "mindmap",
            "scale",
            "cycle",
            "timeline",
            "tree"
          ]
        },
        "title": {
          "type": "string",
          "description": "Título corto de la zona."
        },
        "left_title": {
          "type": "string",
          "description": "Sólo compare: título de la columna izquierda."
        },
        "right_title": {
          "type": "string",
          "description": "Sólo compare: título de la columna derecha."
        },
        "min_label": {
          "type": "string",
          "description": "Sólo scale: etiqueta del extremo izquierdo de la barra (por defecto '0%')."
        },
        "max_label": {
          "type": "string",
          "description": "Sólo scale: etiqueta del extremo derecho de la barra (por defecto '100%')."
        },
        "center_label": {
          "type": "string",
          "description": "Sólo cycle: texto del centro del ciclo, lo que cicla (p. ej. 'Ventana de contexto')."
        },
        "place": {
          "type": "object",
          "description": "Pista opcional de colocación respecto a otra zona.",
          "properties": {
            "relation": {
              "type": "string",
              "enum": [
                "right_of",
                "below"
              ]
            },
            "of": {
              "type": "string",
              "minLength": 1,
              "description": "Id de la zona de referencia."
            }
          },
          "required": [
            "relation",
            "of"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "title"
      ],
      "additionalProperties": false
    },
    "eager_input_streaming": true
  },
  {
    "name": "add_step",
    "description": "Añade un paso (rectángulo) a una zona flow. 'after' conecta automáticamente con el paso anterior.",
    "input_schema": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "minLength": 1,
          "description": "Id de una zona flow."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único."
        },
        "label": {
          "type": "string",
          "description": "Texto breve del paso (2 a 6 palabras)."
        },
        "icon": {
          "type": "string",
          "description": "Emoji opcional."
        },
        "after": {
          "type": "string",
          "minLength": 1,
