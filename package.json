{
  "name": "grafito",
  "private": true,
  "version": "0.2.0-alpha.3",
  "description": "Hablas y Claude dibuja una pizarra en vivo, trazo a trazo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jorgehsy/grafito.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "iconos:aws": "tsx scripts/iconos-aws.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/kalam": "^5.3.0",
    "ajv": "^8.20.0",
    "d3-hierarchy": "^3.1.2",
    "dotenv": "^18.0.8",
    "elkjs": "^0.12.0",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
